# Copy to .env.local and fill in. Then on the deployed agent:
#   lk agent update-secrets --secrets-file .env.local

# --- LiveKit (only needed for local dev; LK Cloud injects these at runtime) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Datadog log drain (LK Cloud built-in; client token, NOT API key) ---
DATADOG_TOKEN=
# DATADOG_REGION=us1   # us1 default; or us3, us5, eu, ap1, us1-fed

# --- Datadog APM via in-container OTel Collector ---
DD_API_KEY=
DD_SITE=datadoghq.com   # or us3/us5/datadoghq.eu/ap1.datadoghq.com

# --- Optional tagging applied to spans ---
OTEL_SERVICE_NAME=livekit-otel-demo
DD_ENV=dev
DD_VERSION=0.1.0
